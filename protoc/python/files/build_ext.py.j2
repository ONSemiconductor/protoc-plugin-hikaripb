"""
Optional: compile {{ p }}_codec.py into a C extension (needs Cython, setuptools and a C compiler).

    python {{ p }}_build_ext.py

The extension is written next to {{ p }}_codec.py and is picked up automatically by the next import
(Python prefers an extension module over a .py file of the same name). Without it, or when this
build fails, the generated modules keep working on the pure Python implementation.
"""

import os
import shutil
import sys
import tempfile


def main():
    try:
        from Cython.Build import cythonize
        from setuptools import setup
    except ImportError as exc:
        print("{{ p }}_build_ext: %s; staying on the pure Python codec (pip install cython setuptools)" % exc)
        return 1

    here = os.path.dirname(os.path.abspath(__file__))
    work_dir = tempfile.mkdtemp(prefix="{{ p }}_codec_build_")
    os.chdir(here)
    try:
        setup(
            name="{{ p }}_codec",
            ext_modules=cythonize(["{{ p }}_codec.py"], build_dir=work_dir, language_level=3, quiet=True),
            script_args=["build_ext", "--inplace", "--build-temp", work_dir, "--build-lib", work_dir],
        )
    except (Exception, SystemExit) as exc:
        print("{{ p }}_build_ext: build failed (%s); staying on the pure Python codec" % exc)
        return 1
    finally:
        shutil.rmtree(work_dir, ignore_errors=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
