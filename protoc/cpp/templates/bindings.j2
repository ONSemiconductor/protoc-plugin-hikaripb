#include "{{ incpath }}{{ p }}_bindings.h"
{% for dep in dependencies %}
#include "{{ dep }}"
{% endfor %}

static const {{ p }}::MessageDescriptor bindings [] = {
{% for item in data %}
{% set msgprefix = item["fullname"] | replace('::', '_') %}
#if !{{msgprefix}}_writeonly
    { &{{item["fullname"]}}::getItemDescriptor,  &{{item["fullname"]}}::clear
#if {{ P }}_DEBUG && {{ P }}_PRINT_ENABLE
    ,&{{item["fullname"]}}::getTagName
#endif
    },
#endif
{% endfor %}
};

const {{ p }}::MessageDescriptor& {{ p }}::getMessageDescriptor(pb_msgid id){
    {# a variable: a table with an entry for every value of pb_msgid makes the check always true, which the compiler warns of #}
    const pb_size index = static_cast<pb_size>(id);

    {{ P }}_ASSERT(index < (sizeof(bindings) / sizeof(bindings[0])));
    return bindings[index];
}

const char* {{ p }}::getMessageName(pb_msgid id){
    const char* name;

    switch(id){
{% for item in data %}
{% set msgprefix = item["fullname"] | replace('::', '_') %}
#if !{{msgprefix}}_writeonly
    case MSG_ID_{{msgprefix}}: name = "{{item["name"]}}"; break;
#endif
{% endfor %}
    default: name = "unknown message"; break;
    }
    return name;
}

