/**
 * @file    {{ p }}_types.h
 * @brief   Standard types and features of the protobuf library: the integer types, the type of a size, the type of a
 *          field number, the type of a message identifier and offsetof.
 *
 * The library takes nothing from the C++ or C library. What it needs of it is defined here, as macros.
 * {{ p }}_defines.h includes this file behind {{ p }}_config.h, and every macro is defined only when {{ p }}_config.h has
 * not defined it before. The integer types are the ones that the compiler names in its predefined macros (GCC and
 * Clang), or the C++ types of a 32-bit target. A target with other types defines the macros in {{ p }}_config.h, for
 * example as the types of <stdint.h> or of a platform header that the config includes:
 *
 * @code
 * #include <stdint.h>
 * #define pb_u32 uint32_t
 * @endcode
 */

#ifndef {{ P }}_TYPES_H
#define {{ P }}_TYPES_H
{% set types = [
    ("s8", "__INT8_TYPE__", "signed char", "Signed 8-bit integer type"),
    ("s16", "__INT16_TYPE__", "short", "Signed 16-bit integer type"),
    ("s32", "__INT32_TYPE__", "int", "Signed 32-bit integer type"),
    ("s64", "__INT64_TYPE__", "long long", "Signed 64-bit integer type"),
    ("u8", "__UINT8_TYPE__", "unsigned char", "Unsigned 8-bit integer type"),
    ("u16", "__UINT16_TYPE__", "unsigned short", "Unsigned 16-bit integer type"),
    ("u32", "__UINT32_TYPE__", "unsigned int", "Unsigned 32-bit integer type"),
    ("u64", "__UINT64_TYPE__", "unsigned long long", "Unsigned 64-bit integer type"),
    ("size", "__SIZE_TYPE__", "unsigned int", "Unsigned type of a size"),
] %}
{% for name, builtin, plain, description in types %}
/** {{ description }}. */
#ifndef pb_{{ name }}
#ifdef {{ builtin }}
#define pb_{{ name }} {{ builtin }}
#else
#define pb_{{ name }} {{ plain }}
#endif
#endif
{% endfor %}

/** Type of a field number: the smallest of pb_u8, pb_u16 and pb_u32 that holds the largest one of the schema ({{ max_tag }}). */
#ifndef pb_tag
#define pb_tag {{ tag_type }}
#endif

/** Type of a message identifier: the smallest of pb_u8, pb_u16 and pb_u32 that holds the identifier of every message of the schema ({{ msg_count }} messages). */
#ifndef pb_msgid
#define pb_msgid {{ msgid_type }}
#endif

/**
 * Offset of a member in a struct. Define it as offsetof of <cstddef> in {{ p }}_config.h for a compiler that is neither
 * GCC compatible nor MSVC and for a checker of a coding standard: the fallback below dereferences a null pointer.
 */
#ifndef PB_OFFSETOF
#if defined(__GNUC__) || defined(_MSC_VER)
#define PB_OFFSETOF(type, member) __builtin_offsetof(type, member)
#else
#define PB_OFFSETOF(type, member) \
    (static_cast<pb_u32>(reinterpret_cast<const pb_u8*>(&(reinterpret_cast<type*>(0)->member)) - reinterpret_cast<const pb_u8*>(0)))
#endif
#endif

#endif /* {{ P }}_TYPES_H */
