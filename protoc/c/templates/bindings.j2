#include "{{ p }}_bindings.h"
{% for dep in dependencies %}
#include "{{ dep }}"
{% endfor %}

{# one dispatch-table entry per non-writeonly message, indexed by its {{ p }}_MessageId #}
const struct {{ p }}_MessageDescriptor* {{ p }}_getMessageDescriptor(pb_msgid id){
    static const struct {{ p }}_MessageDescriptor bindings [] = {
{% for item in data %}
#if !{{item}}_writeonly
        { &{{item}}_getItemDescriptor,  &{{item}}_clear
#if {{ P }}_DEBUG && {{ P }}_PRINT_ENABLE
        , &{{item}}_getTagName
#endif
        },
#endif
{% endfor %}
    };

    {# a variable: a table with an entry for every value of pb_msgid makes the check always true, which the compiler warns of #}
    const pb_size index = (pb_size)id;

    {{ P }}_ASSERT(index < (sizeof(bindings) / sizeof(bindings[0])));
    return &bindings[index];
}

{# debug/print-only: message id -> readable name #}
const char* {{ p }}_getMessageName(pb_msgid id){
    const char* name;

    switch((enum {{ p }}_MessageId)(id)){
{% for item in data %}
#if !{{item}}_writeonly
    case {{item}}_ID: name = "{{item}}"; break;
#endif
{% endfor %}
    default: name = "unknown message"; break;
    }
    return name;
}
