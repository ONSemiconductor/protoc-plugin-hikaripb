#ifndef {{ P }}_DECODE_H
#define {{ P }}_DECODE_H

#include "{{ config.include_path }}{{ p }}_bindings.h"
#include "{{ config.include_path }}{{ p }}_defines.h"

#ifdef __cplusplus
extern "C" {
#endif

{# per-field dispatch used by decode.c.j2's tb_* callbacks and by callback-enabled fields #}
/**
 * @brief Decodes an item based on its descriptor.
 * @param decoder_ctx Decoder context that owns error state and reader context when {{ P }}_ENABLE_MULTI_DEC is enabled.
 * @param item_data Pointer to the raw item data.
 * @param desc Pointer to the item descriptor.
 * @param len Length of the item data.
 */
void {{ p }}_decode_item({{ P }}_DEC_CTX_DEF(struct {{ p }}_DecodeContext* decoder_ctx,)
                         pb_u8* item_data,
                         const struct {{ p }}_ItemDescriptor* desc,
                         pb_u32 len);


/**
 * @brief Decodes a message based on its ID.
 * @param decoder_ctx Decoder context that owns error state and reader context when {{ P }}_ENABLE_MULTI_DEC is enabled.
 * @param msg Pointer to the message structure to populate.
 * @param msgID ID of the message to decode.
 */
{# entry point called by every generated message's inline _decode() wrapper, see message_src.j2 #}
void {{ p }}_decode({{ P }}_DEC_CTX_DEF(struct {{ p }}_DecodeContext* decoder_ctx,) void* msg, pb_msgid msgID);

/**
 * @brief Checks if there was an error during decoding.
 *
 * A message that was decoded with an error can hold invalid fields, for example a string that the end of the input cuts
 * off is only partly written: do not use the message.
 * @param decoder_ctx Decoder context to query when {{ P }}_ENABLE_MULTI_DEC is enabled.
 * @return true if there was an error, false otherwise.
 */
{# call after {{ p }}_decode() to check whether the message was fully consumed without errors #}
pb_bool {{ p }}_hasError({{ P }}_DEC_CTX_ONLY(const struct {{ p }}_DecodeContext* decoder_ctx));

/**
 * @brief Retrieves the decoding error.
 * @param decoder_ctx Decoder context to query when {{ P }}_ENABLE_MULTI_DEC is enabled.
 * @return The decoding error as an {{ p }}_DecodeError enum value.
 */
enum {{ p }}_DecodeError {{ p }}_getError({{ P }}_DEC_CTX_ONLY(const struct {{ p }}_DecodeContext* decoder_ctx));

#ifdef __cplusplus
}
#endif

#endif /* {{ P }}_DECODE_H */
