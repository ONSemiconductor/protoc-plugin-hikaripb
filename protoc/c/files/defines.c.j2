#include "{{ p }}_defines.h"

{# debug/print-only helpers, compiled out entirely when {{ P }}_PRINT_ENABLE is 0 #}
void {{ p }}_print_bytes(const pb_u8* data, pb_u16 len, pb_u32 indent) {
#if {{ P }}_PRINT_ENABLE
    char line[((pb_u32){{ P }}_CHARS_PER_LINE * 3U) + 1U];
    const char* hexDigits = "0123456789ABCDEF";
    pb_u32 data_idx = 0U;
    pb_u32 remaining = (pb_u32)len;

    while (remaining != 0U) {
        for (pb_u32 space = 0U; space < indent; space++) {
            {{ P }}_PRINT(" ");
        }

        const pb_u32 chunk_size = (remaining > (pb_u32){{ P }}_CHARS_PER_LINE) ? (pb_u32){{ P }}_CHARS_PER_LINE : remaining;
        for (pb_u32 i = 0U; i < chunk_size; i++) {
            const pb_u32 value = (pb_u32)data[data_idx];
            const pb_size pos = (pb_size)i * 3U;
            line[pos] = hexDigits[(value >> 4U) & 0x0FU];
            line[pos + 1U] = hexDigits[value & 0x0FU];
            line[pos + 2U] = ' ';
            data_idx++;
        }
        line[(pb_size)chunk_size * 3U] = '\0';
        {{ P }}_PRINTLN("%s", line);
        remaining -= chunk_size;
    }
#else
    (void)data;
    (void)len;
    (void)indent;
#endif
}

void {{ p }}_print_string(const pb_u8* data, pb_u16 len, pb_u32 indent) {
#if {{ P }}_PRINT_ENABLE
    char line[(pb_u32){{ P }}_CHARS_PER_LINE + 1U];
    pb_u32 data_idx = 0U;
    pb_u32 remaining = (pb_u32)len;

    while (remaining != 0U) {
        for (pb_u32 space = 0U; space < indent; space++) {
            {{ P }}_PRINT(" ");
        }

        const pb_u32 chunk_size = (remaining > (pb_u32){{ P }}_CHARS_PER_LINE) ? (pb_u32){{ P }}_CHARS_PER_LINE : remaining;
        for (pb_u32 i = 0U; i < chunk_size; i++) {
            line[i] = (char)data[data_idx];
            data_idx++;
        }
        line[chunk_size] = '\0';
        {{ P }}_PRINTLN("%s", line);
        remaining -= chunk_size;
    }
#else
    (void)data;
    (void)len;
    (void)indent;
#endif
}
