#include "{{ p }}_encode.h"

{# varint/fixed primitives declared in encode.h.j2. The buffers are not zero-filled: a fill is a memset call for every
   varint on a small target, and only the bytes that put_varint() and the loops wrote are passed to write #}
{# the varint of val at buffer: 1 to 5 bytes, the buffer holds 5 at least; returns the count. The index is 32 bits wide,
   so that the loop does not narrow it; the cast to pb_u8 keeps the low 7 bits and the continuation bit #}
static pb_u8 put_varint(pb_u8* buffer, pb_u32 val) {
    pb_u32 rest = val;
    pb_u32 len = 0U;

    while (rest > 0x7FU) {
        buffer[len] = (pb_u8)(rest | 0x80U);
        rest >>= 7U;
        len++;
    }
    buffer[len] = (pb_u8)rest;
    return (pb_u8)(len + 1U);
}

{# the key of a field number below 16 is one byte: no call for it #}
static pb_u8 put_key(pb_u8* buffer, pb_u32 key) {
    pb_u8 len = 1U;

    if (key <= 0x7FU) {
        buffer[0] = (pb_u8)key;
    } else {
        len = put_varint(buffer, key);
    }
    return len;
}

void {{ p }}_encode_uint32_extend({{ P }}_ENC_CTX_DEF(void* ctx,) pb_u32 val, pb_u8 len) {
    pb_u8 buffer[5];
    pb_u32 temp_val = val;
    // a varint has at most 5 bytes, the buffer cannot hold more
    const pb_u8 count = (len > (pb_u8)5U) ? (pb_u8)5U : len;

    {{ P }}_ASSERT(len <= 5U);
    for (pb_u8 i = 0U; i < count; i++) {
        pb_u32 byte_value = temp_val & 0x7FU;
        temp_val >>= 7U;
        if (((pb_u32)i + 1U) < (pb_u32)count) {
            byte_value |= 0x80U;
        }
        buffer[i] = (pb_u8)byte_value;
    }

    {{ p }}_write({{ P }}_ENC_CTX_DEF(ctx,) buffer, (pb_u16)count);
}

void {{ p }}_encode_varint_s32({{ P }}_ENC_CTX_DEF(void* ctx,) pb_s32 val) {
    {{ p }}_encode_varint_u32({{ P }}_ENC_CTX_DEF(ctx,) {{ p }}_zigzag(val));
}

void {{ p }}_encode_varint_u32({{ P }}_ENC_CTX_DEF(void* ctx,) pb_u32 val) {
    pb_u8 buffer[5];
    const pb_u8 len = put_varint(buffer, val);

    {{ p }}_write({{ P }}_ENC_CTX_DEF(ctx,) buffer, (pb_u16)len);
}

{# a field is written with one call of write: the call of the user's function costs more than the bytes #}
void {{ p }}_encode_field_varint({{ P }}_ENC_CTX_DEF(void* ctx,) pb_u32 key, pb_u32 val) {
    pb_u8 buffer[10];
    const pb_u8 key_len = put_key(buffer, key);
    const pb_u8 val_len = put_varint(&buffer[key_len], val);

    {{ p }}_write({{ P }}_ENC_CTX_DEF(ctx,) buffer, (pb_u16)((pb_u32)key_len + (pb_u32)val_len));
}

void {{ p }}_encode_field_fixed32({{ P }}_ENC_CTX_DEF(void* ctx,) pb_u32 key, pb_u32 val) {
    pb_u8 buffer[9];
    const pb_u8 key_len = put_key(buffer, key);

    {# the wire format is little-endian; splitting the value into bytes works on any host byte order #}
    buffer[key_len] = (pb_u8)(val & 0xFFU);
    buffer[key_len + 1U] = (pb_u8)((val >> 8U) & 0xFFU);
    buffer[key_len + 2U] = (pb_u8)((val >> 16U) & 0xFFU);
    buffer[key_len + 3U] = (pb_u8)((val >> 24U) & 0xFFU);
    {{ p }}_write({{ P }}_ENC_CTX_DEF(ctx,) buffer, (pb_u16)((pb_u32)key_len + 4U));
}

{# the length of a field in the {{ P }}_ENC_PAD_LENGTH bytes that are reserved for it: a varint that continuation bits pad
   to that size. The count is a constant, so this is shorter than the loop of {{ p }}_encode_uint32_extend() #}
static void put_padded_length(pb_u8* buffer, pb_u32 length) {
    pb_u32 rest = length;
    pb_u32 i = 0U;

    while ((i + 1U) < (pb_u32){{ P }}_ENC_PAD_LENGTH) {
        buffer[i] = (pb_u8)((rest & 0x7FU) | 0x80U);
        rest >>= 7U;
        i++;
    }
    buffer[i] = (pb_u8)(rest & 0x7FU);
}

void {{ p }}_LenDelimited_destroy({{ P }}_ENC_CTX_DEF(void* ctx,) const struct {{ p }}_LenDelimited* len_delimited) {
    const pb_u32 new_off = {{ p }}_getWriteOffset({{ P }}_ENC_CTX_DEF(ctx));
    const pb_u32 start = len_delimited->offset;
    const pb_u32 pad = (pb_u32){{ P }}_ENC_PAD_LENGTH;
    pb_u32 length = 0U;
    pb_u8 buffer[{{ P }}_ENC_PAD_LENGTH];

    {{ p }}_setWriteOffset({{ P }}_ENC_CTX_DEF(ctx,) start);  // reset offset to the beginning of the message
    {{ P }}_ASSERT(new_off >= (start + pad));
    if (new_off >= (start + pad)) {
        length = new_off - start - pad;
    }
    // the reserved bytes cannot hold a longer length: it would be written truncated, i.e. wrong
    {{ P }}_ASSERT(length <= (pb_u32){{ P }}_ENC_MAX_LENGTH);
    put_padded_length(buffer, length);
    {{ p }}_write({{ P }}_ENC_CTX_DEF(ctx,) buffer, (pb_u16){{ P }}_ENC_PAD_LENGTH);
    {{ p }}_setWriteOffset({{ P }}_ENC_CTX_DEF(ctx,) new_off);
    {{ P }}_DBG_DEF(*len_delimited->destructed = PB_TRUE;)  // mark as destructed
}