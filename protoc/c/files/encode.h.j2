 * @param handle Pointer to the {{ p }}_EncodeHandle structure.
 * @param tag The field tag.
 * @param val The pb_u32 value to add.
 */
{# tag+value writers called from proxy_message.j2's generated set_*() functions: one write per field #}
static inline void {{ p }}_EncodeHandle_addFixed_u32({{ P }}_ENC_CTX_DEF(void* ctx,) const struct {{ p }}_EncodeHandle *handle, pb_u32 tag,
                                                       pb_u32 val) {
    {{ P }}_DBG_DEF({{ P }}_ASSERT(handle->writeToken != PB_FALSE);)
    (void)handle;
    {{ p }}_encode_field_fixed32({{ P }}_ENC_CTX_DEF(ctx,) (tag << 3U) | ((pb_u8){{ P }}_WIRE_FIXED32), val);
}

