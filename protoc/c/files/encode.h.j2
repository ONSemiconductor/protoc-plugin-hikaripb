/**
 * @brief Encode a pb_u32 value using extended encoding (fixed length).
 * @param ctx Writer context.
 * @param val The pb_u32 value to encode.
 * @param len The length in bytes to use for encoding.
 */
void {{ p }}_encode_uint32_extend({{ P }}_ENC_CTX_DEF(void* ctx,) pb_u32 val, pb_u8 len);

/**
 * @brief Encode a pb_s32 value using variable-length encoding.
