 * @param sub Pointer to the {{ p }}_EncodeHandle structure to initialize as submessage.
 * @param handle Pointer to the parent {{ p }}_EncodeHandle structure.
 * @param ctx Writer context.
 * @param tag The field tag for the submessage.
 */
static inline void {{ p }}_EncodeHandle_add(struct {{ p }}_EncodeHandle *sub, struct {{ p }}_EncodeHandle *handle, {{ P }}_ENC_CTX_DEF(void* ctx,) pb_u32 tag) {
    {{ P }}_DBG_DEF({{ P }}_ASSERT(handle->writeToken != PB_FALSE);)
    {{ P }}_DBG_DEF(handle->writeToken = PB_FALSE;)
    (void)handle;
    {{ p }}_Handle_init(sub, {{ P }}_ENC_CTX_DEF(ctx,) tag {{ P }}_DBG_DEF(, &handle->writeToken));
